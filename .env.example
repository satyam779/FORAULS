# Copy to .env for local development (`npm run dev`), and add the same
# variables in Vercel → Project → Settings → Environment Variables.

# --- Supabase (Project Settings → API) -------------------------------------
# Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…) or the legacy "anon" key. Safe in the browser.
VITE_SUPABASE_KEY=
# Secret key (sb_secret_…) or the legacy "service_role" key. SERVER ONLY — never
# prefix it with VITE_. Used by /api/orders to save orders.
SUPABASE_SECRET_KEY=

# --- Order emails (SMTP) ----------------------------------------------------
# Gmail: SMTP_USER = your Gmail address, SMTP_PASS = an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: sender shown to customers (defaults to "FORAULS <SMTP_USER>")
MAIL_FROM=
# Optional: where new-order alerts go (e.g. your own email)
ORDER_NOTIFY_EMAIL=
